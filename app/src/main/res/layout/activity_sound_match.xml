<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E8F5E9">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- En-tête avec bouton retour -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#4CAF50"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="15dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🔊 Devine le Son"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Statistiques -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:background="#C8E6C9"
            android:orientation="horizontal"
            android:padding="15dp">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Score: 0"
                android:textColor="#1B5E20"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Tour: 1/10"
                android:textColor="#1B5E20"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Instruction -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👂 Écoute attentivement le son :"
            android:textSize="22sp"
            android:textColor="#388E3C"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="30dp"
            android:padding="15dp"
            android:background="#FFFFFF"/>

        <!-- Bouton Play -->
        <Button
            android:id="@+id/btnPlaySound"
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"
            android:background="#FFEB3B"
            android:elevation="12dp"
            android:gravity="center"
            android:text="🔊\nÉcouter"
            android:textColor="#FF9800"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Compteur écoutes -->
        <TextView
            android:id="@+id/tvListenCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Écoutes restantes: 3"
            android:textSize="18sp"
            android:textColor="#757575"
            android:layout_gravity="center"
            android:layout_marginBottom="25dp"/>

        <!-- Options -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Choisis l'image correspondante"
            android:textColor="#E91E63"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Boutons -->
        <GridLayout
            android:id="@+id/gridOptions"
            android:layout_width="250dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:background="#FFFFFF"
            android:columnCount="2"
            android:elevation="4dp"
            android:padding="10dp"
            android:rowCount="2">

            <!-- Les boutons images seront ajoutés dynamiquement -->

        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:padding="10dp">

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Suivant ➔"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#4CAF50"
                android:layout_marginLeft="10dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
